# Alfred Configuration Template
# Copy this to .env and fill in your actual values

# ===== Security =====
# Shared secret required on every /chat, /api/*, and /ws request to
# brain_api/server.py (send it as `X-Alfred-Key: <value>` or
# `Authorization: Bearer <value>`; /ws also accepts `?key=<value>`).
# Without this, the server generates and logs a temporary key on startup
# instead of running unauthenticated -- but that changes on every
# restart, so set a real one before exposing the server via ngrok.
ALFRED_API_KEY=choose-a-long-random-value-here

# ===== LLM Providers =====
# Get free keys from:
#  - Groq: https://console.groq.com (very fast, free tier)
#  - Google: https://console.cloud.google.com (enable Gemini API)
#  - OpenRouter: https://openrouter.ai (aggregates many models, free trial)

GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_API_KEY=sk-or-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ===== Path Configuration =====
# Where Alfred stores notes, vault, bootstrap files
OBSIDIAN_VAULT_PATH=C:\Users\samra\Documents\ObsidianVault

# ===== Optional: Remote Access =====
# ngrok token for remote access to Alfred server
# Get from: https://ngrok.com
NGROK_AUTH_TOKEN=YOUR_NGROK_TOKEN

# ===== Logging & Debug =====
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Set to true for verbose output
DEBUG=false

# ===== Server Configuration =====
# Host and port for brain_api server
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# ===== Optional: Voice Configuration =====
# Path to voice models (if using local TTS/STT)
VOICE_MODEL_PATH=./vosk-model-small-en-us-0.15

# ===== Optional: Database =====
# Path to local SQLite database for memory
DB_PATH=./data/alfred.db

# ===== Optional: Memory Configuration =====
# Token budgets for conversation
CONVERSATION_BUDGET=12000
SYSTEM_PROMPT_BUDGET=8000

# ===== Optional: Feature Flags =====
# Enable/disable experimental features
ENABLE_HEARTBEAT=true
ENABLE_SKILL_GENERATION=true
ENABLE_T3_MEMORY_INJECTION=false  # Coming in Phase 1 Day 7
ENABLE_GOAL_INFERENCE=false       # Coming in Phase 1 Day 7
